---
import { assetPath } from '../lib/articles';
import { getEntry } from 'astro:content';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  type?: 'website' | 'article';
  published?: Date;
  image?: string;
  imageAlt?: string;
}
const site = await getEntry('siteSettings', 'site');
if (!site) throw new Error('Missing content/pages/site.md');
const { title, description = site.data.description, type = 'website', published, image, imageAlt } = Astro.props;
const pageTitle = title ? `${title} | ${site.data.name}` : site.data.homePageTitle;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang="it" data-theme="stefano">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {site.data.prototype && <meta name="robots" content="noindex, nofollow" />}
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content={type} />
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {image && <meta property="og:image" content={new URL(assetPath(image, base), Astro.site).href} />}
    {imageAlt && <meta property="og:image:alt" content={imageAlt} />}
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content={site.data.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <link rel="icon" type="image/svg+xml" href={assetPath('/favicon.svg', base)} />
    <title>{pageTitle}</title>
  </head>
  <body class="bg-base-100 font-sans text-base-content antialiased">
    <header class="sticky top-0 z-50 border-b border-secondary/30 bg-primary text-primary-content">
      <div class="navbar mx-auto flex max-w-6xl flex-nowrap px-4 py-3 sm:px-6 sm:py-4">
        <div class="navbar-start min-w-0 flex-1">
          <a class="flex items-center gap-3 no-underline" href={assetPath('/', base)} aria-label={`${site.data.name}, ${site.data.homeLabel}`}>
            <div class="avatar avatar-placeholder" aria-hidden="true">
              <div class="w-10 rounded-md border border-secondary/70 bg-primary text-primary-content">
                <span class="font-display text-sm font-bold">{site.data.brandMark}</span>
              </div>
            </div>
            <span class="text-xs leading-tight font-bold tracking-[.08em]">{site.data.brandFirstLine}<br />{site.data.brandSecondLine}</span>
          </a>
        </div>
        <nav class="navbar-end hidden sm:flex" aria-label={site.data.navigationLabel}>
          <ul class="menu menu-horizontal gap-3 p-0 text-sm font-semibold">
            <li><a class="hover:bg-primary-content/10 hover:text-secondary" href={assetPath('/#about', base)}>{site.data.navAbout}</a></li>
            <li><a class="hover:bg-primary-content/10 hover:text-secondary" href={assetPath('/#articles', base)}>{site.data.navArticles}</a></li>
          </ul>
        </nav>
        <nav class="navbar-end w-auto sm:hidden" aria-label={site.data.navigationLabel}>
          <details class="dropdown dropdown-end" data-mobile-menu>
            <summary class="btn btn-ghost btn-sm text-primary-content" aria-label={site.data.mobileMenuLabel}>
              <svg aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
              {site.data.mobileMenuLabel}
            </summary>
            <ul class="menu dropdown-content z-50 mt-2 w-48 rounded-md border border-base-300 bg-base-100 p-2 text-base-content">
              <li><a href={assetPath('/#about', base)}>{site.data.navAbout}</a></li>
              <li><a href={assetPath('/#articles', base)}>{site.data.navArticles}</a></li>
            </ul>
          </details>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="footer sm:footer-horizontal bg-neutral px-6 py-9 text-neutral-content">
      <div class="mx-auto flex w-full max-w-6xl flex-col justify-between gap-4 sm:flex-row sm:items-start">
        <div class="flex flex-col gap-1">
          <span class="font-display text-sm font-semibold">© {new Date().getFullYear()} {site.data.name}</span>
          <span class="text-xs text-neutral-content/75">{site.data.vatDisplay}</span>
        </div>
        <span class="text-xs text-neutral-content/75">{site.data.footerMessage}</span>
      </div>
    </footer>
    <script>
      const mobileMenu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
      if (mobileMenu) {
        mobileMenu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => { mobileMenu.open = false; });
        });
        document.addEventListener('pointerdown', (event) => {
          if (!mobileMenu.contains(event.target as Node)) mobileMenu.open = false;
        });
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && mobileMenu.open) {
            mobileMenu.open = false;
            mobileMenu.querySelector('summary')?.focus();
          }
        });
      }
    </script>
  </body>
</html>
