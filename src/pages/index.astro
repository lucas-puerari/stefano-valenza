---
import BaseLayout from '../layouts/BaseLayout.astro';
import { assetPath, formatDate, getPublishedArticles, needsAccentDot } from '../lib/articles';
import { getEntry, render } from 'astro:content';

const home = await getEntry('homePage', 'home');
const about = await getEntry('aboutPage', 'about');
const collaborations = await getEntry('collaborationsPage', 'collaborations');
const site = await getEntry('siteSettings', 'site');
const missingPages = [
  !home && 'home.md',
  !about && 'about.md',
  !collaborations && 'collaborations.md',
  !site && 'site.md',
].filter(Boolean);
if (!home || !about || !collaborations || !site) {
  throw new Error(`Content not loaded: ${missingPages.join(', ')}. Check content/pages/ and restart the dev server if the files were just added.`);
}
const { Content: HomeContent } = await render(home);
const { Content: AboutContent } = await render(about);
const { Content: CollaborationsContent } = await render(collaborations);
const typeLabels = {
  review: site.data.reviewLabel,
  guide: site.data.guideLabel,
  story: site.data.storyLabel,
};
const articles = await getPublishedArticles();
// Feature a real published article only when the homepage can show other articles too.
const publishedArticles = articles.filter((article) => !article.data.draft);
const featuredArticle = publishedArticles.length > 1 ? publishedArticles[0] : undefined;
const homepageArticles = articles.filter((article) => article.id !== featuredArticle?.id).slice(0, 3);
const base = import.meta.env.BASE_URL;
---
<BaseLayout>
  <section class="bg-primary text-primary-content" aria-labelledby="home-title">
    <div class:list={['mx-auto grid max-w-6xl gap-[clamp(1.5rem,4vw,3.5rem)] px-5 py-[clamp(2.75rem,6vw,6rem)] sm:px-6', featuredArticle && 'lg:grid-cols-[3fr_2fr] lg:items-end']}>
      <div>
        <p class="text-xs font-semibold tracking-[.12em] text-secondary">{home.data.eyebrow}</p>
        <h1 id="home-title" class:list={['mt-5 max-w-3xl font-display leading-[1.12] font-semibold tracking-tight', featuredArticle ? 'text-[clamp(2rem,4vw,3.5rem)]' : 'text-[clamp(2rem,6.5vw,4.5rem)]']}>
          <span class="block">{home.data.titleFirstLine}</span>
          <span class="block">{home.data.titleSecondLine}</span>
          <em class="block text-secondary">{home.data.titleEmphasis}</em>
        </h1>
        <div class="mt-5 max-w-xl text-[clamp(1rem,1.2vw,1.125rem)] leading-relaxed text-primary-content/90 [&_p]:text-primary-content/90"><HomeContent /></div>
      </div>
      {featuredArticle && (
        <aside class="card border border-secondary/40 bg-base-100 text-base-content" aria-label={home.data.featuredLabel}>
          {featuredArticle.data.cover && (
            <figure><img class="aspect-[16/9] w-full object-cover" src={assetPath(featuredArticle.data.cover, base)} alt={featuredArticle.data.coverAlt} /></figure>
          )}
          <div class="card-body">
            <p class="text-xs font-semibold tracking-[.12em] text-warning">{home.data.featuredLabel}</p>
            <div class="flex flex-wrap items-center gap-2 text-xs">
              <span class="badge badge-outline badge-sm">{typeLabels[featuredArticle.data.type]}</span>
              {featuredArticle.data.draft && <span class="badge badge-soft badge-error badge-sm">{site.data.draftLabel}</span>}
              <time datetime={featuredArticle.data.date.toISOString()}>{formatDate(featuredArticle.data.date)}</time>
            </div>
            <h2 class="card-title mt-2 font-display text-2xl leading-snug font-semibold">{featuredArticle.data.title}</h2>
            <p class="leading-relaxed text-base-content/75">{featuredArticle.data.description}</p>
            <div class="card-actions mt-3">
              <a class="btn btn-outline btn-primary" href={assetPath(`/articles/${featuredArticle.id}/`, base)}>{site.data.readArticleLabel} <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </aside>
      )}
    </div>
  </section>

  <section id="about" class="scroll-mt-24 bg-base-200" aria-labelledby="about-title">
    <div class:list={['mx-auto grid max-w-6xl gap-[clamp(1.5rem,4vw,3.5rem)] px-5 pt-[clamp(2.75rem,6vw,6rem)] sm:px-6', about.data.portrait ? 'lg:grid-cols-[3fr_2fr] lg:items-end' : 'pb-[clamp(2.75rem,6vw,6rem)]']}>
      <div class:list={[about.data.portrait ? 'lg:pb-[clamp(2.75rem,6vw,6rem)]' : 'max-w-3xl']}>
        <p class="text-xs font-semibold tracking-[.12em] text-warning">{about.data.eyebrow}</p>
        <h2 id="about-title" class="mt-4 font-display text-[clamp(2rem,4vw,3.25rem)] leading-tight font-semibold tracking-tight">{about.data.title}<span class="text-accent">.</span></h2>
        <div class="prose mt-5 max-w-2xl sm:prose-lg"><AboutContent /></div>
      </div>
      {about.data.portrait && (
        /* Elbows rest on the section's bottom edge and the hands hang over it.
           Image is 760x803; the torso between the arms is cut at y=571 (arms and hands stay whole),
           so the bust never crosses the section edge. Overhang = 0.305 x 760 = 232px, putting y=571.2 on the edge;
           a negative percentage margin (relative to width) pulls it out of the layout.
           Keep the margin and the crop line in sync if the image is re-exported. */
        <div class="relative z-10 mx-auto w-[min(100%,22rem)] self-end">
          <img class="-mb-[30.5%] block h-auto w-full" src={assetPath(about.data.portrait, base)} alt={about.data.portraitAlt} width="760" height="803" loading="lazy" />
        </div>
      )}
    </div>
  </section>

  <section id="articles" class:list={['mx-auto max-w-6xl scroll-mt-24 px-5 py-[clamp(2.75rem,6vw,6rem)] sm:px-6', about.data.portrait && 'max-lg:pt-[calc(clamp(2.75rem,6vw,6rem)+6rem)]']} aria-labelledby="articles-title">
    <div class="mb-7 flex flex-wrap items-end justify-between gap-4 sm:mb-9">
      <div>
        <p class="text-xs font-semibold tracking-[.12em] text-warning">{home.data.articlesEyebrow}</p>
        <h2 id="articles-title" class="mt-4 font-display text-[clamp(2rem,4vw,3.25rem)] leading-tight font-semibold tracking-tight">{home.data.articlesTitle}<span class="text-accent">.</span></h2>
        <p class="mt-4 max-w-2xl leading-relaxed text-base-content/75">{home.data.articlesIntro}</p>
      </div>
      <span class="pb-2 text-xs tracking-wider text-base-content/60">{String(articles.length).padStart(2, '0')} {articles.length === 1 ? home.data.articleCountSingularLabel : home.data.articleCountLabel}</span>
    </div>
    {articles.length > 0 ? (
      <>
        <div class="grid gap-4 sm:gap-6 md:grid-cols-2 lg:grid-cols-3">
          {homepageArticles.map((article) => (
            <article class="card relative border border-base-300 bg-base-100 transition-colors focus-within:border-primary hover:border-primary/60">
              {article.data.cover && (
                <figure><img class="aspect-[16/10] w-full object-cover" src={assetPath(article.data.cover, base)} alt={article.data.coverAlt} loading="lazy" /></figure>
              )}
              <div class="card-body p-5 sm:p-6">
                <div class="flex flex-wrap items-center gap-2 text-xs text-base-content/70">
                  <span class="badge badge-outline badge-sm">{typeLabels[article.data.type]}</span>
                  {article.data.draft && <span class="badge badge-soft badge-error badge-sm">{site.data.draftLabel}</span>}
                  <time datetime={article.data.date.toISOString()}>{formatDate(article.data.date)}</time>
                </div>
                <h3 class="card-title mt-3 font-display text-xl leading-snug font-semibold"><a class="after:absolute after:inset-0 after:rounded-box hover:text-accent" href={assetPath(`/articles/${article.id}/`, base)}>{article.data.title}</a></h3>
                <p class="mt-2 text-sm leading-relaxed text-base-content/75">{article.data.description}</p>
                <div class="card-actions mt-auto pt-4">
                  <span class="text-sm font-semibold text-primary" aria-hidden="true">{site.data.readArticleLabel} →</span>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-8 flex justify-end"><a class="btn btn-outline btn-primary" href={assetPath('/articles/', base)}>{site.data.allArticlesLabel} <span aria-hidden="true">→</span></a></div>
      </>
    ) : (
      <div class="alert alert-info" role="status"><span>{home.data.emptyArticles}</span></div>
    )}
  </section>

  <section id="collaborations" class="scroll-mt-24 bg-base-200" aria-labelledby="collaborations-title">
    <div class="mx-auto grid max-w-6xl gap-[clamp(1.5rem,4vw,3.5rem)] px-5 py-[clamp(2.75rem,6vw,6rem)] sm:px-6 lg:grid-cols-[2fr_3fr]">
      <div>
        <p class="text-xs font-semibold tracking-[.12em] text-warning">{collaborations.data.eyebrow}</p>
        <h2 id="collaborations-title" class="mt-4 font-display text-[clamp(2rem,4vw,3.25rem)] leading-tight font-semibold tracking-tight">{collaborations.data.title}{needsAccentDot(collaborations.data.title) && <span class="text-accent">.</span>}</h2>
      </div>
      <div>
        <div class="prose max-w-none sm:prose-lg"><CollaborationsContent /></div>
        {collaborations.data.contactEmail && collaborations.data.contactLabel && (
          <a class="btn btn-primary mt-4" href={`mailto:${collaborations.data.contactEmail}`}>{collaborations.data.contactLabel} <span aria-hidden="true">→</span></a>
        )}
      </div>
    </div>
  </section>
</BaseLayout>
