#!/bin/sh
# Blocks commits on main and runs lint + tests before every commit.
set -e
branch=$(git symbolic-ref --short HEAD 2>/dev/null || true)
if [ "$branch" = "main" ]; then
  echo "pre-commit: committing directly to main is not allowed. Create a branch: git switch -c type/short-slug" >&2
  exit 1
fi
make lint test
